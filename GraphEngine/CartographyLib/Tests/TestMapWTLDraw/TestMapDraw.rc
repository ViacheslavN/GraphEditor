STRINGTABLE
BEGIN
    ID_REDRAW_MAP           "Redraw the map\nRedraw"
    ID_FULL_ZOOM            "Zoom to the full extent of the map\nFull Extent"
    ID_ADD_SHAPE_FILE       "Add an ESRI shape file as a new layer\nAdd Shape File"
    ID_REMOVE_ALL_LAYERS    "Remove all layers from the map\nRemove All Layers"
    ID_ZOOM_IN              "Zoom in\nZoom In"
    ID_ZOOM_OUT             "Zoom out\nZoom Out"
    ID_CLEAR_SELECTION      "Clear the selection (cancels a running conversion)\nClear Selection"
    ID_ADD_SQLITE_DB        "Add the spatial tables of an SQLite database as layers\nAdd SQLite Database"
    ID_CONVERT_SHAPE_TO_SQLITE "Copy a shape file into an SQLite database as a spatial table\nConvert to SQLite"
    ID_VIEW_3D              "Switch between the plan view and the pseudo 3D (perspective) view\n3D View"
    ID_TILT_UP              "Tilt the 3D view more (look farther ahead)\nTilt Up"
    ID_TILT_DOWN            "Tilt the 3D view less (closer to the plan view)\nTilt Down"
    ID_ROTATE_LEFT          "Rotate the map counterclockwise\nRotate Left"
    ID_ROTATE_RIGHT         "Rotate the map clockwise\nRotate Right"
    ID_RESET_ROTATION       "Rotate the map so that north is up\nNorth Up"
    ID_ADD_RASTER           "Add a raster (TIFF / GeoTIFF) as a new layer\nAdd Raster"
    ID_ZOOM_TO_LAYER        "Zoom to the extent of a layer (the last added one is first in the list)\nZoom to Layer"
END

