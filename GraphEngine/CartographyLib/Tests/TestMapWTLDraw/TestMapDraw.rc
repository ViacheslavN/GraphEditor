/////////////////////////////////////////////////////////////////////////////
//
// Toolbar (one button per image of res\toolbar.bmp)
//

IDR_MAINFRAME TOOLBAR 16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
    BUTTON      ID_REDRAW_MAP
    BUTTON      ID_FULL_ZOOM
END


/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New project\tCtrl+N",        ID_FILE_NEW
        MENUITEM "&Open project...\tCtrl+O",    ID_FILE_OPEN
        MENUITEM "&Save project\tCtrl+S",       ID_FILE_SAVE
        MENUITEM "Save project &As...",         ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Layers"
    BEGIN
        MENUITEM "Add &Shape File...\tCtrl+A",  ID_ADD_SHAPE_FILE
        MENUITEM "Add S&QLite database...\tCtrl+D", ID_ADD_SQLITE_DB
        MENUITEM "Add &Raster (TIFF / GeoTIFF)...\tCtrl+T", ID_ADD_RASTER
        MENUITEM SEPARATOR
        MENUITEM "&Convert Shape File to SQLite...", ID_CONVERT_SHAPE_TO_SQLITE
        MENUITEM SEPARATOR
        MENUITEM "&Remove all layers",          ID_REMOVE_ALL_LAYERS
    END
    POPUP "&Map"
    BEGIN
        MENUITEM "&Redraw\tF5",                 ID_REDRAW_MAP
        MENUITEM "&Full extent\tHome",          ID_FULL_ZOOM
        MENUITEM "Zoom to &layer...\tCtrl+L",   ID_ZOOM_TO_LAYER
        MENUITEM "Zoom &in\t+",                 ID_ZOOM_IN
        MENUITEM "Zoom &out\t-",                ID_ZOOM_OUT
        MENUITEM SEPARATOR
        MENUITEM "&Clear selection\tEsc",       ID_CLEAR_SELECTION
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&3D view (navigator)\tF3",    ID_VIEW_3D
        MENUITEM "Tilt &up\tPgUp / Ctrl+Wheel", ID_TILT_UP
        MENUITEM "Tilt &down\tPgDn",            ID_TILT_DOWN
        MENUITEM SEPARATOR
        MENUITEM "Rotate &left\tCtrl+Left / Shift+Wheel", ID_ROTATE_LEFT
        MENUITEM "Rotate &right\tCtrl+Right",   ID_ROTATE_RIGHT
        MENUITEM "&North up\tCtrl+R",           ID_RESET_ROTATION
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About TestMapDraw",          ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\TestMapDraw.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG 0, 0, 187, 102
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,130,81,50,14
    CTEXT           "TestMapDraw Application\n\nGraphEngine CartographyLib",IDC_STATIC,25,57,78,32
    ICON            IDR_MAINFRAME,IDC_STATIC,55,26,18,20
    GROUPBOX        "",IDC_STATIC,7,7,115,88
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL
    "A",            ID_ADD_SHAPE_FILE,      VIRTKEY, CONTROL
    "D",            ID_ADD_SQLITE_DB,       VIRTKEY, CONTROL
    "T",            ID_ADD_RASTER,          VIRTKEY, CONTROL
    "L",            ID_ZOOM_TO_LAYER,       VIRTKEY, CONTROL
    VK_F5,          ID_REDRAW_MAP,          VIRTKEY
    VK_HOME,        ID_FULL_ZOOM,           VIRTKEY
    VK_ADD,         ID_ZOOM_IN,             VIRTKEY
    VK_SUBTRACT,    ID_ZOOM_OUT,            VIRTKEY
    VK_ESCAPE,      ID_CLEAR_SELECTION,     VIRTKEY
    VK_F3,          ID_VIEW_3D,             VIRTKEY
    VK_PRIOR,       ID_TILT_UP,             VIRTKEY
    VK_NEXT,        ID_TILT_DOWN,           VIRTKEY
    VK_LEFT,        ID_ROTATE_LEFT,         VIRTKEY, CONTROL
    VK_RIGHT,       ID_ROTATE_RIGHT,        VIRTKEY, CONTROL
    "R",            ID_RESET_ROTATION,      VIRTKEY, CONTROL
END


