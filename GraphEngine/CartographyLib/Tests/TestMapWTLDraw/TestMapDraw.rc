/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New project\tCtrl+N",        ID_FILE_NEW
        MENUITEM "&Open project...\tCtrl+O",    ID_FILE_OPEN
        MENUITEM "&Save project\tCtrl+S",       ID_FILE_SAVE
        MENUITEM "Save project &As...",         ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Layers"
    BEGIN
        MENUITEM "Add &Shape File...\tCtrl+A",  ID_ADD_SHAPE_FILE
        MENUITEM "Add S&QLite database...\tCtrl+D", ID_ADD_SQLITE_DB
        MENUITEM "Add &Raster (TIFF / GeoTIFF)...\tCtrl+T", ID_ADD_RASTER
        MENUITEM SEPARATOR
        MENUITEM "&Convert Shape File to SQLite...", ID_CONVERT_SHAPE_TO_SQLITE
        MENUITEM SEPARATOR
        MENUITEM "&Remove all layers",          ID_REMOVE_ALL_LAYERS
    END
    POPUP "&Map"
    BEGIN
        MENUITEM "&Redraw\tF5",                 ID_REDRAW_MAP
        MENUITEM "&Full extent\tHome",          ID_FULL_ZOOM
        MENUITEM "Zoom to &layer...\tCtrl+L",   ID_ZOOM_TO_LAYER
        MENUITEM "Zoom &in\t+",                 ID_ZOOM_IN
        MENUITEM "Zoom &out\t-",                ID_ZOOM_OUT
        MENUITEM SEPARATOR
        MENUITEM "&Clear selection\tEsc",       ID_CLEAR_SELECTION
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&3D view (navigator)\tF3",    ID_VIEW_3D
        MENUITEM "Tilt &up\tPgUp / Ctrl+Wheel", ID_TILT_UP
        MENUITEM "Tilt &down\tPgDn",            ID_TILT_DOWN
        MENUITEM SEPARATOR
        MENUITEM "Rotate &left\tCtrl+Left / Shift+Wheel", ID_ROTATE_LEFT
        MENUITEM "Rotate &right\tCtrl+Right",   ID_ROTATE_RIGHT
        MENUITEM "&North up\tCtrl+R",           ID_RESET_ROTATION
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About TestMapDraw",          ID_APP_ABOUT
    END
END


